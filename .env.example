# ---- Local development ------------------------------------------------------
# These match the built-in defaults; override only what you need.
DATABASE_PATH=pharmacy.db
SECRET_KEY=dev-secret-do-not-use-in-prod
FLASK_DEBUG=0

# ---- Durable storage on Vercel (Turso Cloud) --------------------------------
# Set these in the Vercel project's environment variables, not in this file.
# When TURSO_DATABASE_URL is set, the app talks to hosted SQLite over HTTP and
# edits/sales survive cold starts. Leave unset to keep using the local file.
#   TURSO_DATABASE_URL=libsql://my-db-org.turso.io      (required for durable deploy)
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create <db>`>
#   SECRET_KEY=<long random hex>       (required — sessions break without it)
#   ADMIN_USERNAME=admin               (first-boot administrator username)
#   ADMIN_PASSWORD=<strong password>   (first-boot administrator password)
# VERCEL=1 is set automatically by Vercel — never set it locally.